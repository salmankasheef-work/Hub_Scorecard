<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hub Loss — Step 1: Preprocessor</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',system-ui,sans-serif;background:#f0f4ff;color:#1e293b;min-height:100vh}
.header{background:linear-gradient(135deg,#1e3a8a,#4c1d95);color:#fff;padding:20px 28px;box-shadow:0 2px 8px rgba(0,0,0,.25)}
.header h1{font-size:20px;font-weight:800;letter-spacing:-.3px}
.header p{font-size:12px;color:#93c5fd;margin-top:3px}
.body{max-width:820px;margin:28px auto;padding:0 20px}
.step-badge{display:inline-flex;align-items:center;gap:8px;background:#1e3a8a;color:#fff;font-size:11px;font-weight:700;padding:4px 12px;border-radius:99px;margin-bottom:14px;text-transform:uppercase;letter-spacing:.5px}
.card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:24px;margin-bottom:18px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.card h2{font-size:15px;font-weight:800;color:#0f172a;margin-bottom:6px}
.card p{font-size:12px;color:#64748b;line-height:1.7}
.drop-zone{border:2px dashed #93c5fd;border-radius:12px;padding:36px;text-align:center;cursor:pointer;transition:all .2s;background:#eff6ff;margin-top:14px}
.drop-zone:hover,.drop-zone.over{background:#dbeafe;border-color:#2563eb}
.drop-icon{margin-bottom:10px}
.drop-title{font-size:16px;font-weight:700;color:#2563eb}
.drop-sub{font-size:11px;color:#64748b;margin-top:5px;line-height:1.6;font-family:'Courier New',monospace}
.progress-wrap{display:none;margin-top:16px}
.progress-label{font-size:12px;font-weight:700;color:#1e3a8a;margin-bottom:6px}
.progress-bar-bg{height:10px;background:#e2e8f0;border-radius:99px;overflow:hidden}
.progress-bar-fill{height:10px;background:linear-gradient(90deg,#2563eb,#7c3aed);border-radius:99px;transition:width .25s ease}
.progress-sub{font-size:11px;color:#64748b;margin-top:4px}
.log-box{background:#0f172a;color:#4ade80;font-family:'Courier New',monospace;font-size:11px;padding:14px;border-radius:10px;margin-top:14px;min-height:80px;max-height:200px;overflow-y:auto;display:none;line-height:1.7}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-top:16px;display:none}
.stat{background:#f8faff;border:1.5px solid #bfdbfe;border-radius:10px;padding:12px;text-align:center}
.stat-label{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:#64748b;margin-bottom:4px}
.stat-val{font-size:20px;font-weight:800;color:#1e3a8a;font-family:'Courier New',monospace}
.download-wrap{display:none;margin-top:18px;background:linear-gradient(135deg,#ecfdf5,#f0fdf4);border:2px solid #6ee7b7;border-radius:12px;padding:18px 20px;text-align:center}
.download-wrap h3{font-size:15px;font-weight:800;color:#065f46;margin-bottom:6px}
.download-wrap p{font-size:11px;color:#064e3b;margin-bottom:14px}
.btn-download{background:linear-gradient(135deg,#059669,#047857);color:#fff;border:none;padding:11px 28px;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 2px 8px rgba(5,150,105,.3)}
.btn-download:hover{background:linear-gradient(135deg,#047857,#065f46)}
.next-step{background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:14px 16px;margin-top:14px;font-size:12px;color:#1e3a8a;line-height:1.7}
.next-step strong{font-weight:700}
.bucket-ref{font-family:'Courier New',monospace;font-size:10px;color:#475569;line-height:1.9;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px;margin-top:10px}
.bucket-ref span{font-weight:700}
</style>
</head>
<body>

<div class="header">
  <h1>Hub Loss Scorecard — Step 1: Preprocessor</h1>
  <p>Upload your raw 9-lakh-row CSV → instantly compressed to hub-level summary → download for dashboard</p>
</div>

<div class="body">

  <div class="step-badge">Step 1 of 2 — Preprocessing</div>

  <div class="card">
    <h2>How this works</h2>
    <p>
      Your raw CSV has ~9 lakh rows × 87 columns = very heavy for a browser dashboard.<br>
      This preprocessor reads it in chunks, groups everything by <strong>Node</strong> (hub), computes all bucket counts,
      and produces a tiny <strong>hub_summary.csv</strong> with one row per hub (~few hundred rows).
      Upload that small file to the dashboard — it loads in under a second.
    </p>
    <div class="bucket-ref">
      <span style="color:#dc2626">CB 10+:</span>        Loss Bucket 2 ∈ [LM CB Pendency (Self), LM CB Pendency (Franchise)]<br>
      <span style="color:#2563eb">LM-ODC Short:</span>  Loss Bucket 2 = LM to ODC Short<br>
      <span style="color:#7c3aed">Intransit 10+:</span> Loss Bucket 1 = LH Bag Miss<br>
      <span style="color:#d97706">Fwd High 5+:</span>   Loss Bucket 2 = DC Forward Floor Miss<br>
      <span style="color:#0284c7">Fwd Short:</span>     Loss Bucket 2 ∈ [DCH/DCH2 Short Forward, DC-DC Short Forward]<br>
      <span style="color:#059669">RVP Short:</span>     Loss Bucket 2 = DC-DC Short Return<br>
      <span style="color:#dc2626">RTO Pend.:</span>     previous_order_status = RTO or order_status = RTO<br>
      <span style="color:#7c3aed">RVP Pend.:</span>    Loss Bucket 2 = Floor Miss RVP
    </div>
  </div>

  <div class="card">
    <h2>Upload your raw CSV</h2>
    <p>Drag & drop or click below. Works with files up to 500MB+. Processing happens entirely in your browser.</p>

    <div class="drop-zone" id="dropZone"
         onclick="document.getElementById('rawCsv').click()"
         ondragover="dov(event)" ondragleave="dol()" ondrop="dop(event)">
      <div class="drop-icon">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="#2563eb" stroke-width="1.5" stroke-linecap="round"/>
          <polyline points="17,8 12,3 7,8" stroke="#2563eb" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="12" y1="3" x2="12" y2="15" stroke="#2563eb" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="drop-title">Drop your raw CSV here or click to browse</div>
      <div class="drop-sub">
        Handles 9 lakh rows · 87 columns · Any file size<br>
        Expected: Node, Zone, POD, Vertical, Loss Bucket 1, Loss Bucket 2, order_status, previous_order_status, ageing, product_value, debit_value, picked_date, lost_date
      </div>
      <input type="file" id="rawCsv" accept=".csv" style="display:none" onchange="startProcess(event)">
    </div>

    <div class="progress-wrap" id="progressWrap">
      <div class="progress-label" id="progressLabel">Parsing CSV…</div>
      <div class="progress-bar-bg"><div class="progress-bar-fill" id="progressFill" style="width:0%"></div></div>
      <div class="progress-sub" id="progressSub">Please wait…</div>
    </div>

    <div class="log-box" id="logBox"></div>

    <div class="stats-grid" id="statsGrid">
      <div class="stat"><div class="stat-label">Total Rows</div><div class="stat-val" id="s-total">0</div></div>
      <div class="stat"><div class="stat-label">Unique Hubs</div><div class="stat-val" id="s-hubs">0</div></div>
      <div class="stat"><div class="stat-label">CB 10+</div><div class="stat-val" id="s-cb">0</div></div>
      <div class="stat"><div class="stat-label">LM-ODC</div><div class="stat-val" id="s-odc">0</div></div>
      <div class="stat"><div class="stat-label">Intransit</div><div class="stat-val" id="s-it">0</div></div>
      <div class="stat"><div class="stat-label">Fwd Short</div><div class="stat-val" id="s-fs">0</div></div>
      <div class="stat"><div class="stat-label">RVP Short</div><div class="stat-val" id="s-rs">0</div></div>
      <div class="stat"><div class="stat-label">RTO Pend.</div><div class="stat-val" id="s-rto">0</div></div>
    </div>

    <div class="download-wrap" id="downloadWrap">
      <h3>✓ Processing complete!</h3>
      <p id="downloadDesc">hub_summary.csv is ready</p>
      <button class="btn-download" onclick="downloadResult()">↓ Download hub_summary.csv</button>
      <div class="next-step">
        <strong>Next step:</strong> Open <strong>step2_dashboard.html</strong> and upload this <strong>hub_summary.csv</strong> file.
        The dashboard will load instantly with all hub-level data.
      </div>
    </div>
  </div>

</div>

<script>
// ── BUCKET MATCHERS (trim both key and value to handle trailing spaces)
function lb2(r) { return (r['Loss Bucket 2'] || r['Loss Bucket 2 '] || '').trim(); }
function lb1(r) { return (r['Loss Bucket 1'] || '').trim(); }

const BUCKETS = {
  cb:        r => { const v=lb2(r); return v==='LM CB Pendency (Self)' || v==='LM CB Pendency (Franchise)'; },
  odc:       r => lb2(r) === 'LM to ODC Short',
  intransit: r => lb1(r) === 'LH Bag Miss',
  fwdHigh:   r => lb2(r) === 'DC Forward Floor Miss',
  fwdShort:  r => { const v=lb2(r); return v==='DCH/DCH2 Short Forward' || v==='DC-DC Short Forward'; },
  rvpShort:  r => lb2(r) === 'DC-DC Short Return',
  rtoPend:   r => { const p=(r['previous_order_status']||'').trim().toUpperCase(); const o=(r['order_status']||'').trim().toUpperCase(); return p==='RTO' || o==='RTO'; },
  rvpPend:   r => lb2(r) === 'Floor Miss RVP'
};

let resultCSV = '';
let hubMap = {};
let totalRows = 0;
let diagCounts = { cb:0, odc:0, intransit:0, fwdHigh:0, fwdShort:0, rvpShort:0, rtoPend:0, rvpPend:0 };

function dov(e) { e.preventDefault(); document.getElementById('dropZone').classList.add('over'); }
function dol()  { document.getElementById('dropZone').classList.remove('over'); }
function dop(e) { e.preventDefault(); dol(); const f=e.dataTransfer.files[0]; if(f) processFile(f); }
function startProcess(e) { const f=e.target.files[0]; if(f) processFile(f); }

function log(msg) {
  const lb = document.getElementById('logBox');
  lb.style.display = 'block';
  lb.innerHTML += msg + '<br>';
  lb.scrollTop = lb.scrollHeight;
}

function setProgress(pct, label, sub) {
  document.getElementById('progressFill').style.width = pct + '%';
  if (label) document.getElementById('progressLabel').textContent = label;
  if (sub)   document.getElementById('progressSub').textContent = sub;
}

function processFile(file) {
  // Reset state
  hubMap = {}; totalRows = 0;
  Object.keys(diagCounts).forEach(k => diagCounts[k] = 0);
  document.getElementById('progressWrap').style.display = 'block';
  document.getElementById('statsGrid').style.display = 'none';
  document.getElementById('downloadWrap').style.display = 'none';
  document.getElementById('logBox').innerHTML = '';

  const fileSizeMB = (file.size / 1024 / 1024).toFixed(1);
  log(`▶ File: ${file.name} (${fileSizeMB} MB)`);
  setProgress(5, `Reading ${file.name} (${fileSizeMB} MB)…`, 'Starting PapaParse chunk streaming…');

  let chunkNum = 0;
  let firstRowLogged = false;

  Papa.parse(file, {
    header: true,
    skipEmptyLines: 'greedy',
    dynamicTyping: false,
    worker: false,
    chunkSize: 1024 * 512, // 512KB chunks — good balance for 9L rows
    chunk(results, parser) {
      chunkNum++;
      const rows = results.data;
      totalRows += rows.length;

      // Log headers from first chunk
      if (!firstRowLogged && rows.length > 0) {
        firstRowLogged = true;
        const headers = Object.keys(rows[0]);
        log(`✓ Headers detected: ${headers.length} columns`);
        // Check critical columns
        const critical = ['Node','Zone','POD','Vertical','Loss Bucket 1','order_status','previous_order_status'];
        const lb2check = headers.find(h => h.trim() === 'Loss Bucket 2');
        log(`✓ Loss Bucket 2 column: "${lb2check || 'NOT FOUND'}" (raw header)`);
        const missing = critical.filter(c => !headers.includes(c));
        if (missing.length) log(`⚠ Missing columns: ${missing.join(', ')}`);
        else log(`✓ All critical columns present`);
        log(`--- First row sample ---`);
        log(`  Node: "${rows[0]['Node']}", Zone: "${rows[0]['Zone']}", LB2: "${lb2(rows[0])}"`);
      }

      // Process each row
      rows.forEach(r => {
        const node     = (r['Node'] || 'Unknown').trim();
        const zone     = (r['Zone'] || '—').trim();
        const pod      = (r['POD']  || '—').trim();
        const vertical = (r['Vertical'] || '—').trim();
        const nodeType = (r['Node Type'] || '—').trim();
        const ageStr   = r['ageing'] || r['Max Ageing'] || '0';
        const age      = parseFloat(ageStr) || 0;
        const prodVal  = parseFloat(r['product_value'] || 0);
        const debitVal = parseFloat(r['debit_value']   || 0);
        const lostDate = (r['lost_date']   || '').trim();
        const pickedDt = (r['picked_date'] || '').trim();
        const month    = r['picked_month'] ? String(r['picked_month']).trim() : '';
        const year     = r['picked_year']  ? String(r['picked_year']).trim()  : '';
        const lb2val   = lb2(r);
        const lb1val   = lb1(r);

        if (!hubMap[node]) {
          hubMap[node] = {
            node, zone, pod, vertical, nodeType,
            total:0,
            cb:0, odc:0, intransit:0, fwdHigh:0, fwdShort:0, rvpShort:0, rtoPend:0, rvpPend:0,
            totalProdVal:0, totalDebitVal:0, totalAge:0,
            maxAge:0, minDate:'', maxDate:'',
            // monthly breakdown (last 4 months)
            months: {}
          };
        }
        const h = hubMap[node];
        h.total++;
        h.totalProdVal  += prodVal;
        h.totalDebitVal += debitVal;
        h.totalAge      += age;
        if (age > h.maxAge) h.maxAge = age;

        // Date tracking
        const dateStr = lostDate || pickedDt;
        if (dateStr) {
          if (!h.minDate || dateStr < h.minDate) h.minDate = dateStr;
          if (!h.maxDate || dateStr > h.maxDate) h.maxDate = dateStr;
        }

        // Monthly breakdown
        if (month && year) {
          const mk = year + '-' + String(month).padStart(2,'0');
          if (!h.months[mk]) h.months[mk] = { total:0, cb:0, odc:0, intransit:0, fwdShort:0, rvpShort:0, rtoPend:0 };
          h.months[mk].total++;
        }

        // Bucket counting
        const isCB        = BUCKETS.cb(r);
        const isODC       = BUCKETS.odc(r);
        const isIntransit = BUCKETS.intransit(r);
        const isFwdHigh   = BUCKETS.fwdHigh(r);
        const isFwdShort  = BUCKETS.fwdShort(r);
        const isRvpShort  = BUCKETS.rvpShort(r);
        const isRtoPend   = BUCKETS.rtoPend(r);
        const isRvpPend   = BUCKETS.rvpPend(r);

        if (isCB)        { h.cb++;        diagCounts.cb++; }
        if (isODC)       { h.odc++;       diagCounts.odc++; }
        if (isIntransit) { h.intransit++; diagCounts.intransit++; }
        if (isFwdHigh)   { h.fwdHigh++;   diagCounts.fwdHigh++; }
        if (isFwdShort)  { h.fwdShort++;  diagCounts.fwdShort++; }
        if (isRvpShort)  { h.rvpShort++;  diagCounts.rvpShort++; }
        if (isRtoPend)   { h.rtoPend++;   diagCounts.rtoPend++; }
        if (isRvpPend)   { h.rvpPend++;   diagCounts.rvpPend++; }

        // Monthly bucket counts
        if (month && year) {
          const mk = year + '-' + String(month).padStart(2,'0');
          if (h.months[mk]) {
            if (isCB)        h.months[mk].cb++;
            if (isODC)       h.months[mk].odc++;
            if (isIntransit) h.months[mk].intransit++;
            if (isFwdShort)  h.months[mk].fwdShort++;
            if (isRvpShort)  h.months[mk].rvpShort++;
            if (isRtoPend)   h.months[mk].rtoPend++;
          }
        }
      });

      // Update progress every chunk
      const approxPct = Math.min(90, 10 + chunkNum * 3);
      setProgress(approxPct, `Processing chunk ${chunkNum}…`, `${totalRows.toLocaleString()} rows processed so far`);

      if (chunkNum % 10 === 0) {
        log(`  Chunk ${chunkNum}: ${totalRows.toLocaleString()} rows → ${Object.keys(hubMap).length} hubs`);
      }
    },
    complete() {
      setProgress(95, 'Generating hub summary CSV…', 'Almost done…');
      log(`--- Processing complete ---`);
      log(`✓ Total rows: ${totalRows.toLocaleString()}`);
      log(`✓ Unique hubs: ${Object.keys(hubMap).length}`);
      log(`✓ CB 10+: ${diagCounts.cb.toLocaleString()}, ODC: ${diagCounts.odc.toLocaleString()}, Intransit: ${diagCounts.intransit.toLocaleString()}`);
      log(`✓ Fwd Short: ${diagCounts.fwdShort.toLocaleString()}, RVP Short: ${diagCounts.rvpShort.toLocaleString()}`);
      log(`✓ RTO: ${diagCounts.rtoPend.toLocaleString()}, RVP Pend: ${diagCounts.rvpPend.toLocaleString()}`);

      // Check if any bucket matched
      const totalMatched = Object.values(diagCounts).reduce((s,v)=>s+v,0);
      if (totalMatched === 0) {
        log(`⚠ WARNING: No rows matched any bucket filter!`);
        log(`  Check that 'Loss Bucket 2' column values match exactly:`);
        // Sample LB2 values
        const sampleLB2 = new Set();
        Object.values(hubMap).slice(0,5).forEach(h => {});
        // Log actual LB2 values from raw data by re-reading - just note it
        log(`  Tip: The column may have spaces in values. Preprocessor trims all values.`);
      }

      setTimeout(() => generateCSV(), 50);
    },
    error(err) {
      log(`✗ ERROR: ${err.message}`);
      setProgress(0, 'Error', err.message);
    }
  });
}

function generateCSV() {
  const hubs = Object.values(hubMap);
  if (!hubs.length) {
    log('✗ No hub data generated — check your CSV format');
    return;
  }

  // Collect all month keys for monthly columns
  const allMonths = new Set();
  hubs.forEach(h => Object.keys(h.months).forEach(m => allMonths.add(m)));
  const sortedMonths = [...allMonths].sort().slice(-6); // last 6 months

  // Build CSV header
  const monthCols = [];
  sortedMonths.forEach(m => {
    monthCols.push(`m_${m}_total`, `m_${m}_cb`, `m_${m}_odc`, `m_${m}_intransit`, `m_${m}_fwdShort`, `m_${m}_rvpShort`, `m_${m}_rtoPend`);
  });

  const headers = [
    'Node','Zone','POD','Vertical','Node Type',
    'total_rows',
    'cb_count','odc_count','intransit_count','fwdHigh_count','fwdShort_count','rvpShort_count','rtoPend_count','rvpPend_count',
    'total_prod_value','total_debit_value','avg_ageing','max_ageing',
    'min_date','max_date',
    ...monthCols
  ];

  const rows = [headers.join(',')];

  hubs.forEach(h => {
    const avgAge = h.total > 0 ? (h.totalAge / h.total).toFixed(1) : '0';
    const baseRow = [
      esc(h.node), esc(h.zone), esc(h.pod), esc(h.vertical), esc(h.nodeType),
      h.total,
      h.cb, h.odc, h.intransit, h.fwdHigh, h.fwdShort, h.rvpShort, h.rtoPend, h.rvpPend,
      Math.round(h.totalProdVal), Math.round(h.totalDebitVal), avgAge, h.maxAge.toFixed(0),
      esc(h.minDate), esc(h.maxDate)
    ];
    const monthRow = [];
    sortedMonths.forEach(m => {
      const md = h.months[m] || { total:0,cb:0,odc:0,intransit:0,fwdShort:0,rvpShort:0,rtoPend:0 };
      monthRow.push(md.total, md.cb, md.odc, md.intransit, md.fwdShort, md.rvpShort, md.rtoPend);
    });
    rows.push([...baseRow, ...monthRow].join(','));
  });

  resultCSV = rows.join('\n');
  setProgress(100, 'Done!', `${hubs.length} hubs · ${rows.length - 1} summary rows`);

  // Update stat cards
  document.getElementById('s-total').textContent  = totalRows.toLocaleString();
  document.getElementById('s-hubs').textContent   = hubs.length.toLocaleString();
  document.getElementById('s-cb').textContent     = diagCounts.cb.toLocaleString();
  document.getElementById('s-odc').textContent    = diagCounts.odc.toLocaleString();
  document.getElementById('s-it').textContent     = diagCounts.intransit.toLocaleString();
  document.getElementById('s-fs').textContent     = diagCounts.fwdShort.toLocaleString();
  document.getElementById('s-rs').textContent     = diagCounts.rvpShort.toLocaleString();
  document.getElementById('s-rto').textContent    = diagCounts.rtoPend.toLocaleString();
  document.getElementById('statsGrid').style.display = 'grid';

  const sizeKB = (new Blob([resultCSV]).size / 1024).toFixed(0);
  document.getElementById('downloadDesc').textContent =
    `hub_summary.csv — ${hubs.length} hub rows · ${sizeKB} KB (was ${(totalRows/10000).toFixed(0)} lakh rows)`;
  document.getElementById('downloadWrap').style.display = 'block';

  log(`✓ hub_summary.csv ready — ${hubs.length} rows, ${sizeKB} KB`);
  log(`▶ Download and upload to step2_dashboard.html`);
}

function esc(v) {
  const s = String(v || '');
  return s.includes(',') || s.includes('"') ? '"' + s.replace(/"/g,'""') + '"' : s;
}

function downloadResult() {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([resultCSV], {type:'text/csv'}));
  a.download = 'hub_summary.csv';
  a.click();
}
</script>
</body>
</html>
